# Sully API keys (get yours at https://dashboard.api.sully.ai)
SULLY_ACCOUNT_ID=
SULLY_API_KEY=
# SULLY_API_BASE_URL=https://api.sully.ai

# Optional: one daily cap on live calls across every server instance.
# Uses the Supabase function sullybuild_take_app_quota(p_app, p_limit).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DAILY_LIVE_LIMIT=500

# Claims stay "false" until each one is true. See README, "Before you turn a claim on".
NEXT_PUBLIC_CLAIM_ZERO_RETENTION=false
NEXT_PUBLIC_CLAIM_HIPAA=false

# The E/M visit level shows CPT codes (99202-99215). Keep "false" until the AMA CPT license question is settled.
ENABLE_EM_LEVEL=false

# Keep search engines out until launch day.
NEXT_PUBLIC_INDEXABLE=false

# Shown in the footer, privacy page and terms.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
